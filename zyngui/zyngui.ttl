@prefix ui:     <http://lv2plug.in/ns/extensions/ui#> .
@prefix zyngui: <http://zynthian.org/ns/lv2/zyngui#> .

# Zynthian widget for this plugin (see zynthian-ui/lv2/zyngui.lv2/zyngui.ttl)
<urn:riban.tuner> ui:ui <urn:riban.tuner#zyngui> .

<urn:riban.tuner#zyngui>
	a zyngui:widget ;
	ui:binary <zynthian_widget_zyntuner.py> ;
	zyngui:apiVersion 1 ;
	zyngui:help <zynthian_widget_zyntuner.html> .
